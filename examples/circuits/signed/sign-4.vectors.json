      "version": 2,
      "source": "# Zweierkomplement, LSB-first: 1 fuer negative Werte, sonst 0 (auch bei null).\ndef SIGN<t>(a):\n    assert t >= 1 and t <= 128\n    return bits(a, t)[t - 1]\n\n# Ergebnisports\nreturn SIGN<t>(a)\n",
