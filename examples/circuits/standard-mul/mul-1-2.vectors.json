    },
    "program": {
      "version": 2,
      "source": "def multiply<w>(a, b):\n    x = bits(a, w)\n    y = bits(b, w)\n    result = [0] * (2 * w)\n    for i in range(w):\n        carry = 0\n        for j in range(w):\n            partial = x[j] & y[i]\n            parity = result[i + j] ^ partial\n            digit = parity ^ carry\n            carry = (result[i + j] & partial) | (parity & carry)\n            result[i + j] = digit\n        result[i + w] = carry\n    return pack(result)\n\nw = p if p >= q else q\nreturn pack(bits(multiply<w>(a, b), p + q))\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "p >= 1",
        "q >= 1",
        "p <= 16",
        "q <= 16"
      ],
      "parameters": {
        "p": 1,
        "q": 2
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "p"
          },
          {
            "name": "b",
            "bits": "q"
          }
        ],
        "outputs": [
          {
            "name": "c",
            "bits": "p+q"
          }
        ]
      }
    },
    "description": "Schiebe-Addier-Multiplikation aus AND-Teilprodukten: vollständiges Produkt mit p+q Bits. Vorzeichenlose Eingänge: a[p], b[q]; unabhängig wählbare Bitbreiten."
