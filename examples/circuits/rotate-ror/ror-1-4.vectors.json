  "metadata": {
    "program": {
      "version": 2,
      "source": "# ROR: Rechtsrotation modulo t, LSB-first; keine Bits gehen verloren.\n# Feste MUX-Stufen wie beim Barrel-Shifter, hier mit zyklischer Verdrahtung.\n\ndef RORStage<t,k>(a, sel):\n    assert t >= 1 and t <= 128 and k >= 0 and k < t\n    x = bits(a, t)\n    if k == 0:\n        return pack(x)\n    en = bits(sel, 1)[0]\n    y = [0] * t\n    for i in range(t):\n        rotated = x[(i + k) % t]\n        y[i] = (x[i] & (1 ^ en)) | (rotated & en)\n    return pack(y)\n\ndef ROR<t,s_bits>(a, s):\n    assert t >= 1 and s_bits >= 1 and t + s_bits <= 128\n    x = bits(a, t)\n    sh = bits(s, s_bits)\n    for j in range(s_bits):\n        k = (2 ** j) % t\n        if k != 0:\n            x = bits(RORStage<t,k>(pack(x), sh[j]), t)\n    return pack(x)\n\n# Ergebnisport\nreturn ROR<t,s_bits>(a, s)\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "t >= 1",
        "s_bits >= 1",
        "t + s_bits <= 128"
      ],
      "parameters": {
        "t": 1,
        "s_bits": 4
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "t"
          },
