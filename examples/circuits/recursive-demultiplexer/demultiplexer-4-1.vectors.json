  "metadata": {
    "seed": 1,
    "bit_order": "LSB-first",
    "interface": {
      "schema": 1,
      "bit_order": "LSB-first",
      "inputs": [
        {
          "name": "a",
          "bits": 4,
          "signed": false,
          "offset": 0
        },
        {
          "name": "b",
          "bits": 1,
          "signed": false,
          "offset": 4
        }
      ],
      "outputs": [
        {
          "name": "c",
          "bits": 8,
          "signed": false,
          "offset": 0,
          "overflow": "error"
        }
      ]
    },
    "program": {
      "version": 2,
      "source": "# n data bits, w selector bits, 2**w packed output channels.\n# Only channel b carries a; all other channels are zero.\ndef DEMUX<n,w>(a, b):\n    assert n >= 1 and w >= 1 and w <= 7 and n + w <= 128 and n * (2 ** w) <= 128\n    x = bits(a, n)\n    s = bits(b, w)\n    lo = [0] * n\n    hi = [0] * n\n    for i in range(n):\n        lo[i] = x[i] & (1 ^ s[w-1])\n        hi[i] = x[i] & s[w-1]\n    if w == 1:\n        return pack(lo + hi)\n    k = n * (2 ** (w - 1))\n    lower = bits(DEMUX<n,w-1>(pack(lo), pack(s[:w-1])), k)\n    upper = bits(DEMUX<n,w-1>(pack(hi), pack(s[:w-1])), k)\n    return pack(lower + upper)\n\nreturn DEMUX<n,w>(a, b)\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "n >= 1",
        "w >= 1",
        "w <= 7",
        "n * (2 ** w) <= 128",
        "n + w <= 128"
      ],
      "parameters": {
        "n": 4,
        "w": 1
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "n"
          },
          {
            "name": "b",
            "bits": "w"
          }
        ],
        "outputs": [
          {
            "name": "c",
            "bits": "n * (2 ** w)"
          }
        ]
      }
    },
    "description": "Demultiplexer: c_b=a, alle anderen Ausgangskanäle sind 0. Verteilt n Datenbits auf einen von 2**w Kanälen. n ist die Datenbreite, w die Breite des Auswahlports b. Kanal j belegt Bits j*n bis (j+1)*n-1 im gepackten Port a (MUX) bzw. c (DEMUX); LSB-first."
  },
  "exhaustive": true
