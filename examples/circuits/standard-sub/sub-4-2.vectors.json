  "metadata": {
    "seed": 1,
    "bit_order": "LSB-first",
    "interface": {
      "schema": 1,
      "bit_order": "LSB-first",
      "inputs": [
        {
          "name": "a",
          "bits": 4,
          "signed": false,
          "offset": 0
        },
        {
          "name": "b",
          "bits": 2,
          "signed": false,
          "offset": 4
        }
      ],
      "outputs": [
        {
          "name": "c",
          "bits": 4,
          "signed": false,
          "offset": 0,
          "overflow": "error"
        },
        {
          "name": "borrow",
          "bits": 1,
          "signed": false,
          "offset": 4,
          "overflow": "error"
        }
      ]
    },
    "program": {
      "version": 2,
      "source": "def subtract<w>(a, b):\n    x = bits(a, w)\n    y = bits(b, w)\n    result = [0] * (w + 1)\n    borrow = 0\n    for i in range(w):\n        parity = x[i] ^ y[i]\n        result[i] = parity ^ borrow\n        borrow = ((1 ^ x[i]) & y[i]) | ((1 ^ parity) & borrow)\n    result[w] = borrow\n    return pack(result)\n\nw = p if p >= q else q\ndifference = bits(subtract<w>(a, b), w + 1)\nreturn pack(difference[:w]), difference[w]\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "p >= 1",
        "q >= 1",
        "p <= 16",
        "q <= 16"
      ],
      "parameters": {
        "p": 4,
        "q": 2
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "p"
          },
          {
            "name": "b",
            "bits": "q"
          }
        ],
        "outputs": [
          {
            "name": "c",
            "bits": "max(p,q)"
          },
          {
            "name": "borrow",
            "bits": 1
          }
        ]
      }
    },
    "description": "Ripple-Borrow-Subtraktion: c=(a-b) modulo 2**max(p,q), borrow=1 genau bei a<b. Vorzeichenlose Eingänge: a[p], b[q]; unabhängig wählbare Bitbreiten."
  },
  "exhaustive": true
}
