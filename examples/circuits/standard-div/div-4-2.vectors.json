  "metadata": {
    "seed": 1,
    "bit_order": "LSB-first",
    "interface": {
      "schema": 1,
      "bit_order": "LSB-first",
      "inputs": [
        {
          "name": "a",
          "bits": 4,
          "signed": false,
          "offset": 0
        },
        {
          "name": "b",
          "bits": 2,
          "signed": false,
          "offset": 4
        }
      ],
      "outputs": [
        {
          "name": "c",
          "bits": 4,
          "signed": false,
          "offset": 0,
          "overflow": "error"
        },
        {
          "name": "rest",
          "bits": 2,
          "signed": false,
          "offset": 4,
          "overflow": "error"
        },
        {
          "name": "valid",
          "bits": 1,
          "signed": false,
          "offset": 6,
          "overflow": "error"
        },
        {
          "name": "div0",
          "bits": 1,
          "signed": false,
          "offset": 7,
          "overflow": "error"
        }
      ]
    },
    "program": {
      "version": 2,
      "source": "def subtract<w>(a, b):\n    # a-b an w Stellen berechnen. Das zusätzliche Bit meldet a<b.\n    # Bitarrays sind LSB-first: x[0] ist die Einerstelle, x[1] die Zweierstelle.\n    x = bits(a, w)\n    y = bits(b, w)\n    result = [0] * (w + 1)\n    borrow = 0  # Leihbit: Die niedrigere Stelle hat sich eine 1 ausgeliehen.\n    for i in range(w):\n        # Ohne eingehendes Leihbit ist das Differenzbit x[i] XOR y[i].\n        parity = x[i] ^ y[i]\n        # Ein eingehendes Leihbit zieht eine weitere 1 ab und kippt dieses Bit.\n        result[i] = parity ^ borrow\n        # Neues Leihbit in zwei Fällen:\n        # 1. x[i]=0, y[i]=1: Die aktuelle Stelle braucht eine geliehene 1.\n        # 2. x[i]=y[i] und borrow=1: Die Leihe muss weitergereicht werden.\n        # Für einzelne Bits bedeutet 1 ^ bit die Umkehrung von 0 und 1.\n        borrow = ((1 ^ x[i]) & y[i]) | ((1 ^ parity) & borrow)\n    # Die unteren w Bits enthalten (a-b) modulo 2**w.\n    # Bit w ist das letzte Leihbit: 1 genau dann, wenn a<b.\n    result[w] = borrow\n    # Beispiel w=2: 1-2 liefert die unteren Bits 11 und Leihbit 1,\n    # also pack([1,1,1])=7. Aufrufer trennen Differenz und Leihbit wieder.\n    return pack(result)\n\n# Schriftliche Binärdivision: a ist der Dividend, b der Divisor.\n# p ist die Bitbreite von a, q die Bitbreite von b; beide sind vorzeichenlos.\n# Bitarrays sind LSB-first: Index 0 ist die Einerstelle (Wert 1).\nx = bits(a, p)\ny = bits(b, q)\nquotient = [0] * p\n# Nach jedem erfolgreichen Schritt ist der Rest kleiner als b.\n# Das Zusatzbit bietet Platz für 2*Rest plus das nächste Dividend-Bit.\nremainder = [0] * (q + 1)\n# Die Division beginnt beim höchsten Bit von a: p-1, p-2, ..., 0.\n# range schliesst die Grenze -1 aus; es gibt genau p feste Stufen.\nfor i in range(p - 1, -1, -1):\n    # Nächstes Bit herunterholen: neuer Rest = 2*alter Rest + x[i].\n    # [x[i]] + remainder[:q] fügt das neue Bit vorne ein;\n    # bei LSB-first rücken die bisherigen Bits dadurch eine Stelle nach oben.\n    remainder = [x[i]] + remainder[:q]\n    # Probe: Passt b in diesen Rest? Dazu versuchsweise Rest-b berechnen.\n    # subtract<q+1> liefert q+1 Differenzbits und ein Leihbit (Borrow).\n    # Insgesamt q+2 Bits; das Leihbit steht an Index q+1.\n    difference = bits(subtract<q+1>(pack(remainder), b), q + 2)\n    # Leihbit 0: Rest>=b, Differenz übernehmen und Quotientenbit auf 1 setzen.\n    # Leihbit 1: Rest<b, bisherigen Rest behalten und Quotientenbit auf 0 setzen.\n    # 1 ^ bit kehrt ein einzelnes Bit um; ^ ist XOR, keine Potenz.\n    take = 1 ^ difference[q + 1]\n    for j in range(q + 1):\n        # Bitweise Auswahl ohne eingabeabhängiges if:\n        # take=1 wählt difference[j], take=0 wählt remainder[j].\n        # Den bisherigen Rest zu behalten heisst hier Wiederherstellung\n        # (englisch restoring). & ist AND, | ist OR.\n        remainder[j] = (difference[j] & take) | (remainder[j] & (1 ^ take))\n    quotient[i] = take\n# Prüfen, ob der Divisor ungleich 0 ist: ODER über alle seine Bits.\nvalid = 0\nfor i in range(q):\n    valid = valid | y[i]\n# b=0 ist ungültig: AND mit valid=0 setzt sämtliche Ergebnisbits auf 0.\n# Für b!=0 bleiben Quotient und Rest unverändert.\nfor i in range(p):\n    quotient[i] = quotient[i] & valid\nfor i in range(q):\n    remainder[i] = remainder[i] & valid\n# pack wandelt LSB-first-Bitarrays zurück in ganze Zahlen.\n# Reihenfolge der Ergebnisports: c, rest, valid, div0.\n# Das Zusatzbit des temporären Rests wird nicht mehr benötigt.\nreturn pack(quotient), pack(remainder[:q]), valid, 1 ^ valid\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "p >= 1",
        "q >= 1",
        "p <= 16",
        "q <= 16"
      ],
      "parameters": {
        "p": 4,
        "q": 2
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "p"
          },
          {
            "name": "b",
            "bits": "q"
          }
        ],
        "outputs": [
          {
            "name": "c",
            "bits": "p"
          },
          {
            "name": "rest",
            "bits": "q"
          },
          {
            "name": "valid",
            "bits": 1
          },
          {
            "name": "div0",
            "bits": 1
          }
        ]
      }
    },
    "description": "Restoring-Division mit p festen Stufen: c=a//b, rest=a%b. Bei b=0: c=rest=valid=0, div0=1; sonst valid=1, div0=0. Vorzeichenlose Eingänge: a[p], b[q]; unabhängig wählbare Bitbreiten."
  },
  "exhaustive": true
}
