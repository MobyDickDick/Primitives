  "metadata": {
    "seed": 1,
    "bit_order": "LSB-first",
    "interface": {
      "schema": 1,
      "bit_order": "LSB-first",
      "inputs": [
        {
          "name": "a",
          "bits": 4,
          "signed": false,
          "offset": 0
        },
        {
          "name": "b",
          "bits": 4,
          "signed": false,
          "offset": 4
        }
      ],
      "outputs": [
        {
          "name": "c",
          "bits": 5,
          "signed": false,
          "offset": 0,
          "overflow": "error"
        }
      ]
    },
    "program": {
      "version": 2,
      "source": "def add<w>(a, b):\n    # Zwei vorzeichenlose Zahlen bitweise addieren; w ist die feste Bitbreite.\n    # bits liefert die Bits von rechts nach links: Index 0 hat den Wert 1,\n    # Index 1 den Wert 2, Index 2 den Wert 4 usw. Fehlende obere Bits sind 0.\n    x = bits(a, w)\n    y = bits(b, w)\n    # Ein zusätzliches Bit nimmt den letzten Übertrag auf: z.B. 1+1 = 10.\n    result = [0] * (w + 1)\n    carry = 0  # Übertrag aus der vorherigen, niedrigeren Stelle.\n    for i in range(w):\n        # ^ ist XOR: 1, wenn genau eines der beiden Bits 1 ist.\n        parity = x[i] ^ y[i]\n        # Das Summenbit berücksichtigt auch den eingehenden Übertrag.\n        result[i] = parity ^ carry\n        # Ein neuer Übertrag entsteht bei zwei gesetzten Eingangsbits\n        # oder wenn ein einzelnes gesetztes Bit zum alten Übertrag hinzukommt.\n        carry = (x[i] & y[i]) | (parity & carry)\n    result[w] = carry\n    # pack setzt das Bitarray wieder zu einer ganzen Zahl zusammen.\n    return pack(result)\n\n# Gemeinsame Rechenbreite: die grössere der beiden Eingangsbreiten.\n# bits(a,w) und bits(b,w) ergänzen schmalere Eingänge oben mit Nullen.\nw = p if p >= q else q\n# Die vollständige Summe hat w+1 Bits, einschliesslich Übertrag.\nreturn add<w>(a, b)\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "p >= 1",
        "q >= 1",
        "p <= 16",
        "q <= 16"
      ],
      "parameters": {
        "p": 4,
        "q": 4
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "p"
          },
          {
            "name": "b",
            "bits": "q"
          }
        ],
        "outputs": [
          {
            "name": "c",
            "bits": "max(p,q)+1"
          }
        ]
      }
    },
    "description": "Ripple-Carry-Addition: vollständige Summe mit max(p,q)+1 Bits. Vorzeichenlose Eingänge: a[p], b[q]; unabhängig wählbare Bitbreiten."
