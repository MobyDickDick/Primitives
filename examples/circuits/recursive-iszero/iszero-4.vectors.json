    "program": {
      "version": 2,
      "source": "# A balanced recursive zero test; each half must be zero.\ndef ISZERO<t>(a):\n    assert t >= 1 and (t & (t - 1)) == 0\n    if t == 1:\n        x = bits(a, 1)\n        return 1 ^ x[0]\n    x = bits(a, t)\n    k = t // 2\n    lo = ISZERO<k>(pack(x[:k]))\n    hi = ISZERO<k>(pack(x[k:]))\n    return lo & hi\n\nreturn ISZERO<t>(a)\n",
      "limits": {
        "steps": 100000,
        "iterations": 10000,
        "total_steps": 5000000
      },
      "conditions": [
        "t >= 1",
        "t <= 64",
        "is_power_of_two(t)"
      ],
      "parameters": {
        "t": 4
      },
      "interface": {
        "inputs": [
          {
            "name": "a",
            "bits": "t"
          }
        ],
        "outputs": [
          {
            "name": "c",
            "bits": 1
          }
        ]
      }
    },
    "description": "Nulltest: c=1 genau für a=0. Rekursive AND-Verknüpfung der Nulltests beider Hälften. t ist eine positive Zweierpotenz."
