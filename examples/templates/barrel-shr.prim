# SHR: logische Rechtsverschiebung, LSB-first; von oben werden Nullen eingefuegt.

def SHRStage<t,k>(a, sel):
    assert t >= 1 and t <= 128 and k >= 1 and k <= t
    x = bits(a, t)
    en = bits(sel, 1)[0]
    y = [0] * t
    for i in range(t):
        shifted = 0
        if i + k < t:
            shifted = x[i + k]
        y[i] = (x[i] & (1 ^ en)) | (shifted & en)
    return pack(y)

def SHR<t,s_bits>(a, s):
    assert t >= 1 and s_bits >= 1 and t + s_bits <= 128
    x = bits(a, t)
    sh = bits(s, s_bits)
    for j in range(s_bits):
        k = 2 ** j
        if k > t:
            k = t
        x = bits(SHRStage<t,k>(pack(x), sh[j]), t)
    return pack(x)

# Ergebnisport
return SHR<t,s_bits>(a, s)
