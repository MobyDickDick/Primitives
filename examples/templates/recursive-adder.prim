# Addition zweier n-Bit-Zahlen, Ergebnis mit Übertrag
# w ist die Bitbreite; Basisfall: ein Bit.
def obereHaelfte<k>(a):
    return a // (2 ** k)

def untereHaelfte<k>(a):
    return a % (2 ** k)

def add<w>(a, b):
    assert w > 0 and (w & (w - 1)) == 0
    assert 0 <= a < 2 ** w and 0 <= b < 2 ** w
    if w == 1:
        return 2 * (a & b) + xor(a, b)
    k = w // 2
    a1 = obereHaelfte<k>(a)
    a2 = untereHaelfte<k>(a)
    b1 = obereHaelfte<k>(b)
    b2 = untereHaelfte<k>(b)
    c0 = add<w - k>(a1, b1)
    c1 = c0 + 1
    d0 = add<k>(a2, b2)
    rest = d0 % (2 ** k)
    carry = d0 // (2 ** k)
    if carry == 0:
        return c0 * (2 ** k) + rest
    else:
        return c1 * (2 ** k) + rest

return add<n>(a, b)
