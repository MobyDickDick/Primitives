# SAR: arithmetische Rechtsverschiebung eines Zweierkomplement-Bitmusters.
# Das hoechste Datenbit wird nachgefuehrt, auch bei s >= t.

def SARStage<t,k>(a, sel):
    assert t >= 1 and t <= 128 and k >= 1 and k <= t
    x = bits(a, t)
    en = bits(sel, 1)[0]
    sign = x[t - 1]
    y = [0] * t
    for i in range(t):
        shifted = sign
        if i + k < t:
            shifted = x[i + k]
        if i == t - 1:
            y[i] = sign
        else:
            y[i] = (x[i] & (1 ^ en)) | (shifted & en)
    return pack(y)

def SAR<t,s_bits>(a, s):
    assert t >= 1 and s_bits >= 1 and t + s_bits <= 128
    x = bits(a, t)
    sh = bits(s, s_bits)
    for j in range(s_bits):
        k = 2 ** j
        if k > t:
            k = t
        x = bits(SARStage<t,k>(pack(x), sh[j]), t)
    return pack(x)

# Ergebnisport
return SAR<t,s_bits>(a, s)
