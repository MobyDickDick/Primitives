# SUB<w>: unsigned Eingaben; bei a < b Ergebnis [const<w>(0), 1].
# Intern bleiben modulare Differenz und Borrow bis zur letzten Stufe erhalten.

# [lo, hi], LSB-first: Breiten muessen bei gepackten Zahlen explizit sein.
def CONCAT<lo_width, hi_width>(lo, hi):
    assert lo_width > 0 and hi_width > 0 and lo_width + hi_width <= 128
    return pack(bits(lo, lo_width) + bits(hi, hi_width))

def const<w>(value):
    assert w > 0 and w <= 128
    return pack(bits(value, w))

def Lower<k>(a):
    assert k > 0 and (k & (k - 1)) == 0
    return pack(bits(a, 2 * k)[:k])

def Higher<k>(a):
    assert k > 0 and (k & (k - 1)) == 0
    return pack(bits(a, 2 * k)[k:])

# a - enable: w modulare Ergebnisbits plus ein Borrow-Bit.
def DEC<w>(a, enable):
    assert w > 0
    x = bits(a, w)
    e = bits(enable, 1)
    digit = x[0] ^ e[0]
    borrow = (1 ^ x[0]) & e[0]
    if w == 1:
        return pack([digit, borrow])
    tail = DEC<w - 1>(pack(x[1:]), borrow)
    return CONCAT<1, w>(digit, tail)

# a - b modulo 2**w plus Borrow. Diese Rekursion darf NICHT nullsetzen.
def SUB_raw<w>(a, b):
    assert w > 0 and (w & (w - 1)) == 0
    if w == 1:
        x = bits(a, 1)
        y = bits(b, 1)
        return pack([x[0] ^ y[0], (1 ^ x[0]) & y[0]])

    k = w // 2
    a_lo = Lower<k>(a)
    a_hi = Higher<k>(a)
    b_lo = Lower<k>(b)
    b_hi = Higher<k>(b)
    lo = bits(SUB_raw<k>(a_lo, b_lo), k + 1)
    hi = bits(SUB_raw<k>(a_hi, b_hi), k + 1)
    adjusted = bits(DEC<k>(pack(hi[:k]), lo[k]), k + 1)
    borrow = hi[k] | adjusted[k]
    c_lo = pack(lo[:k])
    c_hi = CONCAT<k, 1>(pack(adjusted[:k]), borrow)
    return CONCAT<k, k + 1>(c_lo, c_hi)

def SUB<w>(a, b):
    assert w > 0 and (w & (w - 1)) == 0
    if w == 1:
        x = bits(a, 1)
        y = bits(b, 1)
        # Resultat, Borrow: [a0 AND NOT b0, NOT a0 AND b0].
        return pack([x[0] & (1 ^ y[0]), (1 ^ x[0]) & y[0]])
    result = bits(SUB_raw<w>(a, b), w + 1)
    valid = 1 ^ result[w]
    for i in range(w):
        result[i] = result[i] & valid
    return CONCAT<w, 1>(pack(result[:w]), result[w])

result = bits(SUB<n>(a, b), n + 1)
return pack(result[:n]), result[n]
